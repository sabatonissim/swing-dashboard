{
  "trailingSlash": false,
  "functions": {
    "api/page.js": { "includeFiles": "index.html" }
  },
  "rewrites": [
    { "source": "/stock/:ticker", "destination": "/api/page?kind=stock&lang=en&ticker=:ticker" },
    { "source": "/he/stock/:ticker", "destination": "/api/page?kind=stock&lang=he&ticker=:ticker" },
    { "source": "/he", "destination": "/api/page?kind=home&lang=he" },
    { "source": "/stocks", "destination": "/api/page?kind=stocks&lang=en" },
    { "source": "/he/stocks", "destination": "/api/page?kind=stocks&lang=he" },
    { "source": "/learn", "destination": "/api/page?kind=learn-index&lang=en" },
    { "source": "/he/learn", "destination": "/api/page?kind=learn-index&lang=he" },
    { "source": "/learn/:slug", "destination": "/api/page?kind=learn&lang=en&slug=:slug" },
    { "source": "/he/learn/:slug", "destination": "/api/page?kind=learn&lang=he&slug=:slug" },
    { "source": "/:doc(about|privacy|terms)", "destination": "/api/page?kind=doc&lang=en&doc=:doc" },
    { "source": "/he/:doc(about|privacy|terms)", "destination": "/api/page?kind=doc&lang=he&doc=:doc" },
    { "source": "/sitemap.xml", "destination": "/api/page?kind=sitemap" }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Service-Worker-Allowed", "value": "/" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        },
        {
          "key": "Permissions-Policy",
          "value": "geolocation=(), microphone=(), camera=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://s3.tradingview.com https://accounts.google.com https://s.tradingview.com https://cdn.jsdelivr.net https://cdnjs.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://accounts.google.com; font-src https://fonts.gstatic.com; img-src 'self' data: https://*.googleusercontent.com; frame-src https://accounts.google.com https://s.tradingview.com https://www.tradingview-widget.com https://*.tradingview.com; connect-src 'self' https://swing-dashboard-3btx.onrender.com https://accounts.google.com https://*.tradingview.com https://translate.googleapis.com https://clients5.google.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
        }
      ]
    }
  ]
}
